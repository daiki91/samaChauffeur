# --- Server ---
PORT=8000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Supabase project ---
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# --- Database (Supabase Postgres) ---
# Get the DB password from: Supabase Dashboard > Project Settings > Database > Connection string
# DATABASE_URL uses the pooler (pgbouncer, port 6543) for the running app.
# DIRECT_URL uses the direct connection (port 5432) for `prisma migrate`.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@YOUR_HOST:5432/postgres"

# --- Auth (our own JWT, ported 1:1 from djangorestframework-simplejwt) ---
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL=60m
REFRESH_TOKEN_TTL=7d

# --- Twilio (optional, falls back to dev stub logger if unset) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
