# Normalize line endings to LF for all text files, regardless of the
# git config core.autocrlf setting on each contributor's machine (Windows/Mac/Linux).
# This stops the "LF will be replaced by CRLF" warnings on Windows.

* text=auto eol=lf

# Explicit for common source/text types (belt & suspenders)
*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.sql    text eol=lf
*.prisma text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.py     text eol=lf
*.sh     text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf

# Windows-specific scripts should keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
