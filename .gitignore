__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.python-version
*.env
.env
.env.*
!.env.example
env
venv/
.venv/
env/
ENV/
.Python
pip-wheel-metadata/
*.egg-info/
.eggs/
build/
dist/

# Tests / coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/
nosetests.xml
coverage.xml

# Django
*.sqlite3
db.sqlite3
/media/
media/
/staticfiles/
*.log

# Node / frontend
node_modules/
frontend/node_modules/
/build/
/dist/
frontend/dist/
.vite/
.cache/
.parcel-cache/
.npm/
.npmrc
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript
*.tsbuildinfo

# Editor / IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Jupyter
.ipynb_checkpoints

# Secrets / keys
*.pem
*.key

# Misc
*.swp
*~
~$*

